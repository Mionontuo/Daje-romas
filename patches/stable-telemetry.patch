+void EngineSimApplication::publishTelemetry() {
+    TelemetryServer::Snapshot snapshot;
+    snapshot.timestampMs = static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count());
+    snapshot.paused = m_paused;
+
+    if (m_iceEngine == nullptr || m_simulator.getEngine() == nullptr) {
+        m_telemetryServer.publish(snapshot);
+        return;
+    }
+
+    snapshot.connected = true;
+    snapshot.engineName = m_iceEngine->getName();
+    snapshot.rpm = m_iceEngine->getRpm();
+    snapshot.crankAngleDegrees = units::convert(
+        m_iceEngine->getOutputCrankshaft()->getCycleAngle(), units::deg);
+    snapshot.throttle = m_iceEngine->getThrottle();
+    snapshot.torqueNm = units::convert(m_simulator.getFilteredDynoTorque(), units::Nm);
+    snapshot.powerKw = units::convert(m_simulator.getDynoPower(), units::kW);
+    snapshot.manifoldPressureBar = units::convert(m_iceEngine->getManifoldPressure(), units::bar);
+    snapshot.intakeAfr = m_iceEngine->getIntakeAfr();
+    snapshot.exhaustO2Percent = 100.0 * m_iceEngine->getExhaustO2();
+    snapshot.vehicleSpeedKph = (m_vehicle != nullptr)
+        ? units::convert(std::abs(m_vehicle->getSpeed()), units::km / units::hour)
+        : 0.0;
+    snapshot.gear = (m_transmission != nullptr) ? m_transmission->getGear() + 1 : 0;
+    snapshot.simulationFrequency = m_simulator.getSimulationFrequency();
+    snapshot.dynoEnabled = m_simulator.m_dyno.m_enabled;
+    snapshot.ignitionEnabled = m_iceEngine->getIgnitionModule()->m_enabled;
+    snapshot.displacementLitres = units::convert(m_iceEngine->getDisplacement(), units::L);
+    snapshot.redlineRpm = units::toRpm(m_iceEngine->getRedline());
+    const TelemetryServer::ControlState control = m_telemetryServer.getControlState();
+    snapshot.remoteControlEnabled = control.enabled;
+    snapshot.brakePercent = control.enabled ? control.brakePercent : 0.0;
+    snapshot.dynoHold = control.enabled && control.dynoHold;
+    snapshot.dynoTargetRpm = units::toRpm(m_dynoSpeed);
+    snapshot.revLimiterRpm = units::toRpm(m_iceEngine->getIgnitionModule()->getRevLimit());
+    snapshot.ignitionAdvanceOffsetDegrees = units::convert(
+        m_iceEngine->getIgnitionModule()->getTimingAdvanceOffset(), units::deg);
+
+    constexpr double ambientPressure = units::pressure(1.0, units::atm);
+    constexpr double ambientTemperature = units::celcius(25.0);
+    const double theoreticalAirPerRevolution = 0.5 *
+        (ambientPressure * m_iceEngine->getDisplacement()) /
+        (constants::R * ambientTemperature);
+    const double theoreticalAirPerSecond = theoreticalAirPerRevolution * snapshot.rpm / 60.0;
+    snapshot.volumetricEfficiencyPercent = (std::abs(theoreticalAirPerSecond) < 1E-3)
+        ? 0.0
+        : 100.0 * m_iceEngine->getIntakeFlowRate() / theoreticalAirPerSecond;
+
+    const int cylinderCount = m_iceEngine->getCylinderCount();
+    snapshot.chambers.reserve(cylinderCount);
+    for (int cylinderIndex = 0; cylinderIndex < cylinderCount; ++cylinderIndex) {
+        const CombustionChamber *chamber = m_iceEngine->getChamber(cylinderIndex);
+        TelemetryServer::ChamberSample chamberSample;
+        chamberSample.pressureBar = units::convert(chamber->m_system.pressure(), units::bar);
+        chamberSample.volumeCc = units::convert(chamber->getVolume(), units::cc);
+        chamberSample.temperatureC = chamber->m_system.temperature() - units::K0;
+        chamberSample.afr = chamber->lastEventAfr();
+        chamberSample.lit = chamber->isLit();
+
+        const int sampleCount = CombustionChamber::getStateSampleCount();
+        chamberSample.pressureTraceBar.reserve(sampleCount);
+        chamberSample.volumeTraceCc.reserve(sampleCount);
+        for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
+            chamberSample.pressureTraceBar.push_back(
+                units::convert(chamber->getPressureSample(sampleIndex), units::bar));
+            chamberSample.volumeTraceCc.push_back(
+                units::convert(chamber->getVolumeSample(sampleIndex), units::cc));
+        }
+
+        snapshot.chambers.push_back(std::move(chamberSample));
+    }
+
+    m_telemetryServer.publish(snapshot);
+}
+
+void EngineSimApplication::applyRemoteControls() {
+    if (m_iceEngine == nullptr || m_simulator.getEngine() == nullptr) return;
+    const TelemetryServer::ControlState control = m_telemetryServer.getControlState();
+    IgnitionModule *ignition = m_iceEngine->getIgnitionModule();
+    if (!control.enabled) {
+        if (m_remoteControlsPreviouslyEnabled) {
+            m_simulator.m_dyno.m_enabled = false;
+            m_simulator.m_dyno.m_hold = false;
+            m_simulator.m_dyno.m_maxTorque = units::torque(10000.0, units::ft_lb);
+            ignition->setTimingAdvanceOffset(0.0);
+            if (m_remoteDefaultRevLimit > 0.0) ignition->setRevLimit(m_remoteDefaultRevLimit);
+        }
+        m_remoteControlsPreviouslyEnabled = false;
+        return;
+    }
+    if (!m_remoteControlsPreviouslyEnabled) m_remoteDefaultRevLimit = ignition->getRevLimit();
+    m_remoteControlsPreviouslyEnabled = true;
+
+    m_targetSpeedSetting = clamp(control.throttle);
+    m_speedSetting = m_targetSpeedSetting;
+    m_iceEngine->setSpeedControl(m_speedSetting);
+
+    Dynamometer &dyno = m_simulator.m_dyno;
+    dyno.m_enabled = control.brakePercent > 0.01 || control.dynoHold;
+    dyno.m_hold = control.dynoHold;
+    dyno.m_maxTorque = units::torque(25.0 * control.brakePercent, units::Nm);
+    m_dynoSpeed = control.dynoHold
+        ? units::rpm(control.dynoTargetRpm)
+        : units::rpm(0.0);
+    dyno.m_rotationSpeed = m_dynoSpeed;
+
+    ignition->m_enabled = control.ignitionEnabled;
+    ignition->setRevLimit(units::rpm(control.revLimiterRpm));
+    ignition->setTimingAdvanceOffset(units::angle(control.ignitionAdvanceOffsetDegrees, units::deg));
+    m_paused = control.paused;
+}
